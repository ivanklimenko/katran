{
  "name": "@katran/tokens",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/fonts.css"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./tokens.css": "./src/tokens.css",
      "./fonts.css": "./src/fonts.css"
    }
  },
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
