{
  "name": "@katran/tokens",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "katran-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "katran-source": "./src/fonts.ts",
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": false,
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^26.6.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
