{
  "name": "@katran/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/ui.css"
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/ui.js" },
      "./styles.css": "./dist/ui.css"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8",
    "@katran/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
