{
  "name": "@katran/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/ui.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/ui.js"
      },
      "./styles.css": "./dist/ui.css"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8",
    "@katran/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@testing-library/dom": "^8.20.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react": "^6.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
